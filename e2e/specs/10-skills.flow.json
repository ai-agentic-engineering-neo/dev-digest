{
  "name": "Skills page lists seeded skills; the agent editor Skills tab shows the linked set",
  "description": "Opens /skills (master-detail: Skills column on the left, the editor inline on the right), selects the seeded breaking-change card (?skill=), switches the editor to the Versions tab (?tab=versioning) and sees the current version row; then opens the seeded Security Reviewer's Skills tab and confirms the linked count badge and a linked row. No writes, no model call.",
  "steps": [
    {
      "cmd": [
        "open",
        "{BASE}/skills"
      ],
      "label": "load the skills page"
    },
    {
      "cmd": [
        "wait",
        "--url",
        "/skills"
      ],
      "label": "skills route reached"
    },
    {
      "cmd": [
        "wait",
        "--load",
        "networkidle"
      ],
      "label": "skills fetch settles"
    },
    {
      "cmd": [
        "wait",
        "--text",
        "pr-quality-rubric"
      ],
      "label": "seeded skill card is visible"
    },
    {
      "cmd": [
        "find",
        "text",
        "breaking-change",
        "click"
      ],
      "label": "open the first skill card's preview"
    },
    {
      "cmd": [
        "wait",
        "--url",
        "skill="
      ],
      "label": "selection is in the URL"
    },
    {
      "cmd": [
        "wait",
        "--load",
        "networkidle"
      ],
      "label": "skill fetch settles"
    },
    {
      "cmd": [
        "wait",
        "--text",
        "Configuration"
      ],
      "label": "the inline editor renders the Config tab"
    },
    {
      "cmd": [
        "find",
        "role",
        "button",
        "click",
        "--name",
        "Versions"
      ],
      "label": "switch to the Versions tab"
    },
    {
      "cmd": [
        "wait",
        "--url",
        "tab=versioning"
      ],
      "label": "versioning tab is in the URL"
    },
    {
      "cmd": [
        "wait",
        "--text",
        "current"
      ],
      "label": "the current version row renders"
    },
    {
      "cmd": [
        "open",
        "{BASE}/agents"
      ],
      "label": "load the agents page"
    },
    {
      "cmd": [
        "wait",
        "--load",
        "networkidle"
      ],
      "label": "agents fetch settles"
    },
    {
      "cmd": [
        "find",
        "text",
        "Security Reviewer",
        "click"
      ],
      "label": "open the seeded Security Reviewer"
    },
    {
      "cmd": [
        "wait",
        "--url",
        "/agents/"
      ],
      "label": "agent editor reached"
    },
    {
      "cmd": [
        "find",
        "role",
        "button",
        "click",
        "--name",
        "Skills"
      ],
      "label": "switch to the Skills tab"
    },
    {
      "cmd": [
        "wait",
        "--url",
        "tab=skills"
      ],
      "label": "skills tab is in the URL"
    },
    {
      "cmd": [
        "wait",
        "--load",
        "networkidle"
      ],
      "label": "links fetch settles"
    },
    {
      "cmd": [
        "wait",
        "--text",
        "3 of"
      ],
      "label": "linked count badge renders"
    },
    {
      "cmd": [
        "wait",
        "--text",
        "lethal-trifecta"
      ],
      "label": "a linked skill row is visible"
    }
  ]
}
