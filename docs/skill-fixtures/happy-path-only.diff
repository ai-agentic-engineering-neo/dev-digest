+export function parseAmount(raw: string): number {
+  const trimmed = raw.trim();
+  if (trimmed === '') {
+    throw new Error('empty amount');
+  }
+  const n = Number(trimmed);
+  if (Number.isNaN(n)) {
+    throw new Error('invalid amount');
+  }
+  if (n < 0) {
+    throw new Error('negative amount');
+  }
+  return n;
+}
