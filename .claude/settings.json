{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/engineering-insights.py\" prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/engineering-insights.py\" stop",
            "timeout": 30,
            "statusMessage": "Checking engineering-insights wrap-up…"
          }
        ]
      }
    ]
  }
}
