+/**
+ * The most recent of a set of timestamps, or null when there are none — used
+ * by round rollups that may cover a PR with zero runs.
+ */
+export function latestOf(dates: Date[]): Date | null {
+  if (dates.length === 0) return null;
+  return dates.reduce((a, b) => (b > a ? b : a));
+}
