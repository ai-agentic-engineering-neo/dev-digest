+export interface DiscountableOrder {
+  id: string;
+  total: number; // minor units (cents)
+}
+
+/** Applies a percentage discount (0-100) to an order total. */
+export function applyDiscount(order: DiscountableOrder, pct: number): DiscountableOrder {
+  if (pct < 0) throw new RangeError('pct must be >= 0');
+  if (pct > 100) throw new RangeError('pct must be <= 100');
+  if (pct === 0) return order;
+  return { ...order, total: Math.round(order.total * (1 - pct / 100)) };
+}
