{
  "name": "@devdigest/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@ast-grep/napi": "0.43.0",
    "@fastify/autoload": "^6.6.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@vscode/ripgrep": "^1.18.0",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-sse-v2": "^4.2.2",
    "fastify-type-provider-zod": "^4.0.2",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-metrics": "^2.4.2",
    "js-tiktoken": "^1.0.21",
    "octokit": "^4.1.4",
    "openai": "^4.104.0",
    "p-queue": "^8.1.1",
    "postgres": "^3.4.9",
    "simple-git": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^10.28.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
